DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxxx-pooler.region.aws.neon.tech/dbname

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides; defaults are Google's OpenAI-compatible endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# an alias that follows the current flash model, so a retired version won't break it
GEMINI_MODEL=gemini-flash-latest
